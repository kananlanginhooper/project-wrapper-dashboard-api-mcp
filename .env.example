# Copy to .env (gitignored). Placeholders only here.
DASH_PORT=8097
DASH_BIND=0.0.0.0
# exactly what browsers type to reach the wrapper
PUBLIC_URL=http://localhost:8097
UI_BASE_PATH=/
# origins allowed to frame the wrapper itself (normally none)
FRAME_ANCESTORS=
# reverse proxies whose X-Forwarded-* headers are trusted
FORWARDED_ALLOW_IPS=127.0.0.1
# login through the IdP (repo OpenID-Connect-Python-Auth-for-private-sites), once it is live
LOGIN=off
OIDC_ISSUER=
OIDC_CLIENT_ID=home-dashboards

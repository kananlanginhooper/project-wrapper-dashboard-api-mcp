# Copy to .env (gitignored) and edit. Placeholders only here: no secrets, host names or LAN addresses.

# host port for the wrapper
DASH_PORT=8097
# the one IPv4 address the port is published on: 127.0.0.1 keeps it off the network, a LAN address shares it
BIND_ADDR=127.0.0.1
# exactly what browsers type to reach the wrapper
PUBLIC_URL=http://localhost:8097
# path prefix the wrapper is served under (sets <base href>); "/" at the root
UI_BASE_PATH=/
# origins allowed to frame the wrapper itself, space-separated (normally none)
FRAME_ANCESTORS=
# reverse proxies whose X-Forwarded-* headers are trusted (comma-separated IPs)
FORWARDED_ALLOW_IPS=127.0.0.1

# sign-in through the IdP (repo OpenID-Connect-Python-Auth-for-private-sites): on or off
LOGIN=off
# the IdP's public URL, used when LOGIN=on
OIDC_ISSUER=
# this app's client id registered in the IdP
OIDC_CLIENT_ID=home-dashboards

# Tab table (Postgres).
# the database server's address; empty = read config/tabs.json instead
DB_HOST=
# Postgres port
DB_PORT=5432
# database name (the role owns only this database)
DB_NAME=home_dashboards
# database role
DB_USER=home_dashboards
# the role's password (real value only in your .env)
DB_PASSWORD=
# which URL each tab gets: laptop, server, ... ("default" rows apply everywhere)
TABS_ENV=laptop
